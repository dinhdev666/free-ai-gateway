# ============================================================
# Free AI Gateway — Cấu hình biến môi trường
# Tất cả biến đều dùng tiền tố FAG_ để tránh xung đột.
#
# Ngoài ra, bạn có thể đặt các cài đặt này trong:
#   ~/.free-ai-gateway/config.json
#
# Độ ưu tiên: Biến môi trường FAG_* > config.json > giá trị mặc định
# ============================================================

# API key xác thực client cho gateway (tùy chọn).
# Để trống để vô hiệu hóa xác thực (bất kỳ client nào cũng kết nối được).
FAG_API_KEY=

# Cổng lắng nghe của máy chủ (mặc định: 20123)
# FAG_PORT=20123

# URL cổng debug Chrome dùng cho yêu cầu phía trình duyệt và webauth (mặc định: http://127.0.0.1:9222)
# FAG_CDP_URL=http://127.0.0.1:9222
